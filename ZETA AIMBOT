        Text = symbol .. " " .. name,
        TextColor3 = Theme.Text,
        TextSize = 9,
        Font = Enum.Font.GothamBold,
        ZIndex = 103
    }, sidebar)
    corner(button, 6)

    tabButtons[name] = button
    makePage(name)

    button.Activated:Connect(function() animateClick(button); showPage(name) end)
end

local function addToggle(pageName, label, callback)
    local btn = make("TextButton", {
        Size = UDim2.new(1, -4, 0, 26),
        BackgroundColor3 = Theme.Panel,
        Text = label,
        TextColor3 = Theme.Text,
        TextSize = 9,
        Font = Enum.Font.GothamBold,
        ZIndex = 104
    }, pages[pageName])
    corner(btn, 6)
    stroke(btn, Theme.Accent, 0.8)

    local active = false
    btn.Activated:Connect(function()
        animateClick(btn)
        local nextState = not active
        local success, err = pcall(callback, nextState, btn)
        if success then
            active = nextState
            btn.BackgroundColor3 = active and Theme.Accent or Theme.Panel
            notify((active and "Activado: " or "Desactivado: ") .. label, active and Theme.Success or Theme.Danger)
        else
            notify("Error al ejecutar", Theme.Danger)
        end
    end)
    return btn
end

