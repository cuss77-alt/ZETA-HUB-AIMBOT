local activeHighlights = {}
local espConnections = {}
local wallhackEnabled = false
local rgbModeActive = false

local function applyChams(char)
    if not char or activeHighlights[char] then return end
    local hl = Instance.new("Highlight")
    hl.Name = "ZetaWallhack"
    hl.FillColor = Color3.fromRGB(255, 20, 20)
    hl.OutlineColor = Color3.fromRGB(255, 255, 255)
    hl.FillTransparency = 0.35
    hl.OutlineTransparency = 0.1
    hl.Adornee = char
    hl.Parent = char
    activeHighlights[char] = hl
end

addToggle("Visuales", "🔴 Wallhack Rojo", function(s)
    wallhackEnabled = s
    if s then
        for _, p in pairs(Players:GetPlayers()) do
            if p ~= player then
                if p.Character then applyChams(p.Character) end
                table.insert(espConnections, trackConnection(p.CharacterAdded:Connect(applyChams)))
            end
        end
        table.insert(espConnections, trackConnection(Players.PlayerAdded:Connect(function(p)
            table.insert(espConnections, trackConnection(p.CharacterAdded:Connect(applyChams)))
        end)))
        notify("Wallhack Activado", Theme.Success)
    else
        rgbModeActive = false
        for _, conn in ipairs(espConnections) do
            if typeof(conn) == "RBXScriptConnection" then conn:Disconnect() end
        end
        espConnections = {}
        for char, hl in pairs(activeHighlights) do
            if hl then hl:Destroy() end
        end
        activeHighlights = {}
        notify("Wallhack Desactivado", Theme.Danger)
    end
end)

addToggle("Visuales", "🌈 Wallhack Modo RGB", function(s, btn)
    if not wallhackEnabled then
        notify("⚠️ ¡ACTIVA EL WALLHACK PRIMERO!\nPLEASE ACTIVATE WALLHACK FIRST!", Theme.Danger, 5)
        btn.BackgroundColor3 = Theme.Panel
        error("Wallhack base no activo")
    end

    rgbModeActive = s
    if s then
        trackConnection(RunService.RenderStepped:Connect(function()
            if not rgbModeActive or not wallhackEnabled then return end
            local hue = (tick() * 0.25) % 1
            local rgbColor = Color3.fromHSV(hue, 1, 1)
            for _, hl in pairs(activeHighlights) do
                if hl then hl.FillColor = rgbColor end
            end
        end))
        notify("Wallhack RGB Activado", Theme.Success)
    else
        notify("Wallhack RGB Desactivado", Theme.Danger)
    end
end)

